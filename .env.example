# ==========================================
# KONFIGURASI BOT WA & MULTI-PROVIDER AI
# Salin file ini menjadi .env lalu isi nilainya
# ==========================================

# 1. Pilihan Provider AI
# Nilai yang didukung: openai | groq | gemini | openrouter | deepseek | ollama | custom
AI_PROVIDER=gemini

# 2. API Key dari Provider yang dipilih
# Kosongkan jika menggunakan ollama (lokal)
AI_API_KEY=your_api_key_here

# 3. Model yang digunakan
# PERHATIAN: Pada Google AI Studio Free Tier, gemini-3.8-flash memiliki kuota terbatas (20 request/hari).
# Jika butuh kuota ribuan chat/hari secara gratis, gunakan AI_PROVIDER=groq dengan model llama-3.3-70b-versatile.
AI_MODEL=gemini-3.8-flash

# 4. Custom Base URL (Opsional - default otomatis sesuai provider)
AI_BASE_URL=

# 5. Konfigurasi Bot
BOT_NAME="Santri Bot"
COMMAND_PREFIX=!
REQUIRE_PREFIX=true

# 6. Hak Akses & Keamanan Operasional
# Nomor HP Pemilik Bot (format internasional tanpa +, contoh: 6281234567890)
# Perintah sensitif seperti !model dan !status hanya bisa diakses oleh nomor ini.
OWNER_NUMBER=

# Izinkan bot merespons di dalam Grup WhatsApp (true/false)
# Set ke false untuk melindungi kuota dari spam di grup ramai
ALLOW_GROUPS=true

# 7. Metode Pairing Code (Opsional)
# Jika terminal VPS/server Anda tidak bisa menampilkan QR code dengan jelas,
# isi nomor WhatsApp bot Anda di sini (contoh: 6281234567890) untuk mendapatkan kode angka 8 digit.
PAIRING_NUMBER=
